<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FFI/CFFI.fs" />

    <Compile Include="Tools/Utils.fs" />
    <Compile Include="Tools/UnionFind.fs" />

    <Compile Include="Internal/DiagnosticKinds.fs" />
    <Compile Include="Internal/Diagnostics.fs" />

    <Compile Include="Kernel/MathRender.fs" />
    <Compile Include="Kernel/Plot.fs" />
    <Compile Include="Kernel/RepeatingDecimalNumber.fs" />
    <Compile Include="Kernel/Constant.fs" />
    <Compile Include="Kernel/Atomic.fs" />
    <Compile Include="Kernel/Index.fs" />
    <Compile Include="Kernel/Set.fs" />
    <Compile Include="Kernel/Prime.fs" />
    <Compile Include="Kernel/SumPow.fs" />
    <Compile Include="Kernel/TrueVariable.fs" />
    <Compile Include="Kernel/Polynomial.fs" />
    <Compile Include="Kernel/Equation.fs" />
    <Compile Include="Kernel/Context.fs" />
    <Compile Include="Kernel/Factorize.fs" />
    <Compile Include="Kernel/LinearAlgebra.fs" />
    <Compile Include="Kernel/Tensor.fs" />
    <Compile Include="Kernel/Calculus.fs" />
    <Compile Include="Kernel/Solve.fs" />

    <Compile Include="Language/Operator/LiyhUnits.fs" />
    <Compile Include="Language/Operator/LiyhOperators.fs" />
    <Compile Include="Language/Syntax/Indentation.fs" />
    <Compile Include="Language/Syntax/Location.fs" />
    <Compile Include="Language/Syntax/Cosyn.fs" />
    <Compile Include="Language/Syntax/Parser.fs" />
    <Compile Include="Language/Absyn/Absyn.fs" />
    <Compile Include="Language/Evaluation/LinearScan.fs" />
    <Compile Include="Language/Evaluation/Foreign.fs" />
    <Compile Include="Language/Evaluation/IL.fs" />
    <Compile Include="Language/Evaluation/Hex.fs" />
    <Compile Include="Language/Evaluation/VM.fs" />
    <Compile Include="Language/Evaluation/ILParser.fs" />

    <Compile Include="Repl.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="BenchShark" Version="1.0.0">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="ByteDev.Encoding" Version="2.0.0" />
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Include="Plotly.NET" Version="11.0.0-dev-1657117337-e6d9a19" />
    <PackageReference Include="Plotly.NET.ImageExport" Version="11.0.0-dev-1657117337-e6d9a19" />
    <PackageReference Include="PrettyPrompt" Version="4.0.4" />
    <PackageReference Include="ScottPlot" Version="5.0.39" />
    <PackageReference Include="Spectre.Console" Version="0.44.0" />
  </ItemGroup>
</Project>
